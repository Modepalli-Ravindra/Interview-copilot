# Render production image: InterviewPilot backend + OmniRoute in ONE container.
#
# Stage 2 is based on the official OmniRoute image (diegosouzapw/omniroute:latest)
# so we inherit its standalone Next.js runtime, healthcheck script, non-root `node`
# user and /app data layout. We layer the compiled backend on top and make the
# supervisor the explicit PID 1.
#
# We deliberately do NOT inherit the base image's ENTRYPOINT
# (/tmp/check-permissions.sh). It is coupled to that image's internals
# (runs `node docker/ensure-docker-base-path.mjs` on every boot under `set -e`,
# mangles NODE_OPTIONS from a moving `latest` tag) and is a silent failure point
# that can kill the container before our supervisor ever prints a line. Our
# supervisor sets NODE_OPTIONS/heap per child itself and needs none of that.

# ─────────────────────────────────────────────
# Stage 1: build the backend (mirrors backend/Dockerfile)
# ─────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /build

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

RUN npm prune --omit=dev

# ─────────────────────────────────────────────
# Stage 2: runtime — official OmniRoute image + backend
# ─────────────────────────────────────────────
FROM diegosouzapw/omniroute:latest

USER root
WORKDIR /app

# Lay the compiled backend beside OmniRoute's standalone output.
COPY --from=builder /build/dist /app/interviewpilot/dist
COPY --from=builder /build/node_modules /app/interviewpilot/node_modules
COPY --from=builder /build/package.json /app/interviewpilot/package.json

# Writable data dir for the GitHub cache / JSON-store fallback.
RUN mkdir -p /app/interviewpilot/data && chown -R node:node /app/interviewpilot

# Supervisor: starts OmniRoute (:20128) and the backend ($PORT) together.
COPY supervisor.sh /app/supervisor.sh
RUN chmod +x /app/supervisor.sh && chown node:node /app/supervisor.sh

# The official OmniRoute entrypoint keeps a single process; we hand both
# processes to the supervisor, which forwards SIGTERM/SIGINT, reaps children,
# restarts a child that exits, and fails the container if the backend cannot
# stay alive. Explicit ENTRYPOINT so nothing is inherited from the base image.
USER node

EXPOSE 20128 3000

ENTRYPOINT ["/app/supervisor.sh"]
CMD []

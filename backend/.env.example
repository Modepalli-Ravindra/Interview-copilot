# InterviewPilot backend configuration
# Copy to .env and fill in real values. Never commit .env.

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Security ────────────────────────────────────────────────
# JWT secret for account authentication (register/login + all /api routes
# except /health). REQUIRED in production — the server refuses to boot with
# NODE_ENV=production and no JWT_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Test-only bypass used by the offline smoke suites (backend/scripts/*.js).
# NEVER set this in any deployed environment.
AUTH_TEST_MODE=false
# API rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Database (Supabase) ───────────────────────────────────────
# Preferred: Supabase JS client (URL + publishable key).
#   URL:   Project Settings -> API -> Project URL
#   KEY:   Project Settings -> API -> publishable key (sb_publishable_...)
# The publishable (anon) key is only used for the sessions store below.
# Prereq: run backend/db/schema.sql once in the Supabase SQL editor
#         (the JS client cannot create tables itself).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxx

# Backend-only privileged key used for user management (register/login on the
# `users` table). The service-role key bypasses Row-Level Security so RLS can
# stay enabled while the server creates/looks up users.
#   KEY: Project Settings -> API -> service_role key (sb_secret_...)
# SECURITY: backend-only. NEVER expose to the frontend, NEVER put in a
# VITE_* variable, NEVER commit it, NEVER log it. Not needed for the JSON
# file store or the pg DATABASE_URL store.
SUPABASE_SERVICE_ROLE_KEY=

# Alternative: a Postgres connection string (any Postgres incl. Supabase).
# With DATABASE_URL set, the schema is auto-created at boot (pg driver).
# Leave BOTH unset to keep using the JSON file store (local dev).
#   postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Keep true for Supabase (SSL). Set to 'false' only for a local Postgres without SSL.
DATABASE_SSL=true

# ── Resume file storage (Supabase S3-compatible) ───────────────
# Optional: store uploaded resume files so History can re-download them.
# If unset, resume parsing still works but files are not persisted.
#   ENDPOINT: Project Settings -> Storage -> S3-compatible storage endpoint
#   KEYS:     Project Settings -> Storage -> "S3 Access Keys" (create one)
# Note: Supabase S3 always uses path-style addressing and us-east-1.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=resumes
SUPABASE_S3_PATH_STYLE=true

# ── Code execution (Judge0) ──────────────────────────────────
# Optional. Defaults to the public CE endpoint (rate-limited, no key). Only
# set these if you self-host Judge0 or use a RapidAPI-style host.
#   JUDGE0_URL        base URL, e.g. https://ce.judge0.com (or a RapidAPI host)
#   JUDGE0_API_KEY    token sent as X-RapidAPI-Key (RapidAPI hosts only)
#   JUDGE0_HOST       host sent as X-RapidAPI-Host (RapidAPI hosts only)
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_HOST=

# ── AI provider chain (first reachable wins) ─────────────────
AI_PROVIDER_ORDER=omniroute,opencode
AI_GATEWAY_MAX_RETRIES=1

# OmniRoute (primary, free-provider gateway, local proxy on :20128)
# NOTE: use 127.0.0.1 (not localhost) — OmniRoute binds IPv4-only and
# Node 22 resolves localhost to ::1 first, which fails the health check.
OMNIROUTE_URL=http://127.0.0.1:20128
OMNIROUTE_MODEL=auto
# Optional key if OmniRoute is ever configured to require one:
# OMNIROUTE_API_KEY=
OMNIROUTE_TIMEOUT_MS=120000

# opencode provider (fallback; set OPENCODE_SERVER_URL=disabled to turn off)
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_MODEL=
OPENCODE_SERVER_TIMEOUT_MS=90000

# ── Container supervisor (single-container Render deploy) ────
# Read by backend/supervisor.sh only. Heaps are capped to fit the 512MB Render
# free tier; raise them if you move to a paid instance with more RAM.
OMNIROUTE_MEMORY_MB=320
BACKEND_MEMORY_MB=96
